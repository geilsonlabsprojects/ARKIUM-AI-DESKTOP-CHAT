{
  "identifier": "default",
  "description": "Default capabilities for ARKIUM AI Desktop Chat",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-create-dir",
    "fs:allow-remove-dir",
    "fs:allow-remove-file",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-metadata",
    "http:default",
    "http:allow-fetch",
    "notification:default",
    "os:default",
    "shell:allow-open",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "store:default",
    "store:allow-set",
    "store:allow-get",
    "store:allow-has",
    "store:allow-delete",
    "store:allow-clear",
    "store:allow-entries",
    "store:allow-load",
    "store:allow-save",
    "upload:default"
  ]
}
