{
  "identifier": "default",
  "description": "Default capabilities for ARKIUM AI Desktop Chat",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-lstat",
    "fs:allow-create",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-read",
    "fs:scope-home-recursive",
    "fs:scope-document-recursive",
    "fs:scope-desktop-recursive",
    "fs:scope-download-recursive",
    "fs:scope-appdata-recursive",
    "fs:scope-appconfig-recursive",
    "fs:scope-applocaldata-recursive",
    "http:default",
    "http:allow-fetch",
    "http:allow-fetch-send",
    "http:allow-fetch-read-body",
    "http:allow-fetch-cancel",
    "notification:default",
    "os:default",
    "shell:default",
    "shell:allow-open",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "store:default",
    "store:allow-set",
    "store:allow-get",
    "store:allow-has",
    "store:allow-delete",
    "store:allow-clear",
    "store:allow-entries",
    "store:allow-keys",
    "store:allow-load",
    "store:allow-save",
    "store:allow-get-store",
    "upload:default",
    "upload:allow-upload",
    "upload:allow-download"
  ]
}
